[
  {
    "name": "flights",
    "description": "Real-time and scheduled flights with departure/arrival airport, time, gate, status. Combine filters to narrow down.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "flight_iata": {
          "type": "string",
          "description": "IATA flight number (e.g. \"AA100\")"
        },
        "flight_icao": {
          "type": "string",
          "description": "ICAO flight number"
        },
        "dep_iata": {
          "type": "string",
          "description": "Departure airport IATA (e.g. \"JFK\")"
        },
        "arr_iata": {
          "type": "string",
          "description": "Arrival airport IATA"
        },
        "airline_iata": {
          "type": "string",
          "description": "Airline IATA code"
        },
        "flight_status": {
          "type": "string",
          "description": "scheduled | active | landed | cancelled | incident | diverted"
        },
        "limit": {
          "type": "number",
          "description": "1-100 (default 25)"
        },
        "offset": {
          "type": "number",
          "description": "0-based offset"
        }
      }
    }
  },
  {
    "name": "airports",
